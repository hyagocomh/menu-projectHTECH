# PostgreSQL (recomendado: Prisma Postgres pela integracao Storage da Vercel)
DATABASE_URL="postgres://usuario:senha@host:5432/maknas"

# Painel /admin
AUTH_SECRET="gere-com-openssl-rand-base64-32"
ADMIN_USERNAME="usuario-administrador"
ADMIN_PASSWORD_HASH="gere-com-npm-run-admin-hash"

# Chave publica: use apenas Map Tiles e restrinja pelos dominios da loja
NEXT_PUBLIC_GEOAPIFY_MAP_KEY=""

# Chave privada: Address Autocomplete, Geocoding e Routing; nunca use NEXT_PUBLIC_
GEOAPIFY_API_KEY=""

# Coordenadas da loja (origem das entregas)
STORE_LATITUDE="-9.6192548"
STORE_LONGITUDE="-35.7153547"

# Regra de frete: base + km excedente
DELIVERY_BASE_FEE="7.50"
DELIVERY_INCLUDED_KM="2"
DELIVERY_PRICE_PER_KM="2.50"
DELIVERY_MAX_KM="15"
DELIVERY_ROUTING_MODE="scooter"

WHATSAPP_NUMBER="5582999627481"
